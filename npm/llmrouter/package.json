{
  "name": "llmrouter",
  "version": "0.3.0",
  "description": "Cache-aware LLM routing for Node.js: picks the (model, backend) pair, keeps sessions sticky, and chooses prompt-cache TTL per breakpoint. Zero dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "llmrouter": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/",
    "build:demo": "esbuild src/demo.ts --bundle --minify --format=iife --global-name=LLMRouterDemo --outfile=../../website/assets/llmrouter-demo.js"
  },
  "keywords": [
    "llm",
    "router",
    "prompt-caching",
    "kv-cache",
    "cost-optimization",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnshRoshan/llmrouter.git",
    "directory": "npm/llmrouter"
  },
  "homepage": "https://anshroshan.github.io/llmrouter/",
  "bugs": {
    "url": "https://github.com/AnshRoshan/llmrouter/issues"
  },
  "author": "llmrouter contributors",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
